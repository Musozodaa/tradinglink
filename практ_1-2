n = int(input("Введите высоту пирамиды n: "))

for i in range(1, n + 1):
    
    for _ in range(n - i):
        print(" ", end="")
    
    for j in range(1, i + 1):
        print(j, end="")
   
    for j in range(i - 1, 0, -1):
        print(j, end="")
    print()

# 5)
count = int(input("Сколько чисел вы хотите ввести? "))
numbers = []

for i in range(1, count + 1):
    num = float(input(f"Введите число {i}: "))
    numbers.append(num)

max_num = max(numbers)
min_num = min(numbers)
avg_num = sum(numbers) / count

above_avg = 0
for num in numbers:
    if num > avg_num:
        above_avg += 1

if max_num.is_integer():
    max_num = int(max_num)
if min_num.is_integer():
    min_num = int(min_num)

print("Результаты:")
print(f"Максимальное: {max_num}")
print(f"Минимальное: {min_num}")
print(f"Среднее: {avg_num}")
print(f"Чисел больше среднего: {above_avg}")
